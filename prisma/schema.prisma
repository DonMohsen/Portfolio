generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: migrations need a non-pooled URL (advisory locks break on -pooler).
  directUrl = env("DIRECT_URL")
}

enum ProjectTypes {
  Practice
  Copy
  Forked
  Real
}

enum ProjectIndustry {
  Healthcare
  Fintech
  Ecommerce
  AI
  Automation
  Education
  Marketplace
  Enterprise
  SaaS
  Other
}

enum BlogCategory {
  tech
  personal
}

enum BlogStatus {
  draft
  published
}

enum ContactInquiryStatus {
  new
  read
  replied
  archived
}

model Technology {
  id       Int                      @id @default(autoincrement())
  name     String
  projects ProjectsOnTechnologies[]
  imageUrl String
}

model Projects {
  id              Int                      @id @default(autoincrement())
  createdAt       DateTime                 @default(now())
  lastUpdatedAt   DateTime                 @updatedAt
  name            String
  slug            String                   @unique
  description     String
  liveLink        String?
  image           String?
  competency      Int
  projectType     ProjectTypes
  githubLink      String
  industry        ProjectIndustry?
  outcomeMetric   String?
  featured        Boolean                  @default(false)
  role            String?
  year            Int?
  problemHtml     String?                  @db.Text
  insightHtml     String?                  @db.Text
  changeHtml      String?                  @db.Text
  measurementHtml String?                  @db.Text
  failureHtml     String?                  @db.Text
  clientQuote     String?
  clientName      String?
  metricsJson     Json?
  techStack       ProjectsOnTechnologies[]

  @@index([featured])
  @@index([industry])
}

model ProjectsOnTechnologies {
  project      Projects   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId Int
  addedAt      DateTime   @default(now())
  addedBy      String

  @@id([projectId, technologyId])
}

model AdminUser {
  id             Int                 @id @default(autoincrement())
  username       String              @unique
  passwordHash   String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  refreshTokens  AdminRefreshToken[]
}

model BlogPost {
  id               Int          @id @default(autoincrement())
  slug             String       @unique
  status           BlogStatus   @default(draft)
  category         BlogCategory
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  titleEn          String
  titleFa          String
  excerptEn        String
  excerptFa        String
  contentHtmlEn    String       @db.Text
  contentHtmlFa    String       @db.Text
  conclusionHtmlEn String?      @db.Text
  conclusionHtmlFa String?      @db.Text
  heroImage        String?
  readTimeMinutes  Int?
  views            Int          @default(0)
  likes            Int          @default(0)
  faq              Json?
  headings         Json?

  @@index([status, publishedAt(sort: Desc)])
  @@index([category])
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId Int

  @@index([adminUserId])
  @@index([expiresAt])
}

model ContactInquiry {
  id          Int                  @id @default(autoincrement())
  createdAt   DateTime             @default(now())
  name        String
  email       String
  company     String?
  projectType String
  budgetRange String
  timeline    String
  message     String               @db.Text
  locale      String
  source      String?
  status      ContactInquiryStatus @default(new)

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model ToolLead {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  toolSlug   String
  locale     String
  email      String?
  inputsJson Json
  resultJson Json?
  source     String

  @@index([createdAt(sort: Desc)])
  @@index([toolSlug])
}
