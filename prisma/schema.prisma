generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectTypes {
  Practice
  Copy
  Forked
  Real
}

enum BlogCategory {
  tech
  personal
}

enum BlogStatus {
  draft
  published
}

model Technology {
  id       Int                      @id @default(autoincrement())
  name     String
  projects ProjectsOnTechnologies[]
  imageUrl String
}

model Projects {
  id            Int                      @id @default(autoincrement())
  createdAt     DateTime                 @default(now())
  lastUpdatedAt DateTime                 @updatedAt
  name          String
  description   String
  liveLink      String?
  image         String?
  competency    Int
  projectType   ProjectTypes
  githubLink    String
  techStack     ProjectsOnTechnologies[]
}

model ProjectsOnTechnologies {
  project      Projects   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  technologyId Int
  addedAt      DateTime   @default(now())
  addedBy      String

  @@id([projectId, technologyId])
}

model AdminUser {
  id             Int                 @id @default(autoincrement())
  username       String              @unique
  passwordHash   String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  refreshTokens  AdminRefreshToken[]
}

model BlogPost {
  id               Int          @id @default(autoincrement())
  slug             String       @unique
  status           BlogStatus   @default(draft)
  category         BlogCategory
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  titleEn          String
  titleFa          String
  excerptEn        String
  excerptFa        String
  contentHtmlEn    String       @db.Text
  contentHtmlFa    String       @db.Text
  conclusionHtmlEn String?      @db.Text
  conclusionHtmlFa String?      @db.Text
  heroImage        String?
  readTimeMinutes  Int?
  views            Int          @default(0)
  likes            Int          @default(0)
  faq              Json?
  headings         Json?

  @@index([status, publishedAt(sort: Desc)])
  @@index([category])
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId Int

  @@index([adminUserId])
  @@index([expiresAt])
}
